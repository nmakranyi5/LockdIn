# Copy to .env (gitignored) and fill in from Supabase: Project Settings → API.
# These are read at build time. The anon key is designed to be public: your
# data is protected by the row-level security rules in supabase/migrations.
# NEVER put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
